# ===============================================
# Configuración del Backend (Local / Docker / Railway)
# ===============================================

PORT=5000
NODE_ENV=production

# Opción 1: Conexión URL directa de Railway (Recomendada en Railway)
# MYSQL_URL=mysql://root:password@roundhouse.proxy.rlwy.net:12345/railway
# DATABASE_URL=mysql://root:password@roundhouse.proxy.rlwy.net:12345/railway

# Opción 2: Variables individuales (Provistas automáticamente por Railway MySQL plugin o .env local)
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLUSER=app_user
MYSQLPASSWORD=12345
MYSQLDATABASE=tatuaje
